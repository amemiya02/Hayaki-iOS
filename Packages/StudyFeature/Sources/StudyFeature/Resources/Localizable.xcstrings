            "state": "translated",
            "value": "次のカード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一张卡片"
          }
        }
      }
    },
    "Custom scheduling could not run. Standard intervals were kept." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムスケジュールを実行できなかったため、標準の間隔を使用しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义排程未能运行，已保留标准间隔。"
          }
        }
      }
    },
    "Custom Study" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタム学習"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义学习"
          }
        }
      }
    },
    "Allow Collection Access" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションへのアクセスを許可"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许访问集合"
          }
        }
      }
    },
    "Allow Opening Other Apps" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアプリを開くことを許可"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许打开其他 App"
          }
        }
      }
    },
    "Allow Speech Recognition" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声認識を許可"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许语音识别"
          }
        }
      }
