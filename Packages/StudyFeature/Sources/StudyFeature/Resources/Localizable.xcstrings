{
  "sourceLanguage" : "en",
  "strings" : {
    "Next review in %@" : {
      "comment" : "Answer notice: when the rated card comes back, such as 4d.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回は %@ 後"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 后再次复习"
          }
        }
      }
    },
    "Next learning card %@" : {
      "comment" : "Finished screen: the time the next learning card comes due today.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の学習カード %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下一张学习卡 %@"
          }
        }
      }
    },
    "New study day %@" : {
      "comment" : "Finished screen: when the next study day starts, such as \"Tomorrow, 4:00 AM\".",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい学習日 %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新的学习日 %@"
          }
        }
      }
    },
    "Reviewed" : {
      "comment" : "Under the number of cards reviewed in the session.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復習済み"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已复习"
          }
        }
      }
    },
    "Time" : {
      "comment" : "Under the time spent studying in the session.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用时"
          }
        }
      }
    },
    "Buttons in Bar" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーにボタンを表示"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在栏中显示按钮"
          }
        }
      }
    },
    "Layout" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レイアウト"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "布局"
          }
        }
      }
    },
    "Card Kanji/Hanzi Style" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードの漢字字形"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡片汉字字形"
          }
        }
      }
    },
    "Follow App Language" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの言語に従う"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟随应用语言"
          }
        }
      }
    },
    "Sets how Han characters on cards are drawn. Fonts chosen by a card’s template are kept." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード上の漢字の字形を選びます。カードのテンプレートで指定されたフォントはそのまま使われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置卡片上汉字的字形。卡片模板指定的字体保持不变。"
          }
        }
      }
    },
    "Card was a leech." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカードは苦手カードです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张卡片是吸血卡。"
          }
        }
      }
    },
    "Card was a leech and has been suspended." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "苦手カードのため、一時停止しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张卡片是吸血卡，已暂停。"
          }
        }
      }
    },
    "Could Not Display Card": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードを表示できませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法显示卡片"
