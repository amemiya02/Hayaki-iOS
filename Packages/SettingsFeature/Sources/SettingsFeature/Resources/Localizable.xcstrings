    "Restore a Backup" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップを復元"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复备份"
          }
        }
      }
    },
    "Backups are stored in Hayaki’s Backups folder in Files. Export a collection package to include media." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップは「ファイル」の Hayaki にある Backups フォルダに保存されます。メディアも含めるにはコレクションパッケージを書き出してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份存放在“文件”中 Hayaki 的 Backups 文件夹。若要包含媒体，请导出集合包。"
          }
        }
      }
    },
    "A collection package (.colpkg) replaces the receiving collection." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションパッケージ（.colpkg）は、取り込み先のコレクション全体を置き換えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集合包（.colpkg）会替换接收端的整个集合。"
          }
        }
      }
    },
    "A deck package (.apkg) merges into the receiving collection." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デッキパッケージ（.apkg）は、取り込み先のコレクションに統合されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "牌组包（.apkg）会合并到接收端的集合中。"
          }
        }
      }
    },
